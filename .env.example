# ─────────────────────────────────────────────────────────────────────────────
# Tech Mentor ERP & POS — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in all values marked REQUIRED
# 3. NEVER commit .env to source control
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string.
# Local example:  postgresql://postgres:password@localhost:5432/techmentor
# Railway:        injected automatically from the PostgreSQL plugin — do not set manually
DATABASE_URL=postgresql://user:password@localhost:5432/techmentor

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# REQUIRED. Secret used to sign JWT tokens. Use a minimum 64-character hex string.
# Generate:  openssl rand -hex 64
SESSION_SECRET=change_me_to_a_64_char_or_longer_random_hex_string

# ── Node Environment ──────────────────────────────────────────────────────────
# Use "production" when deploying. Enables static frontend serving in the API server.
NODE_ENV=production

# ── Server Port ───────────────────────────────────────────────────────────────
# DO NOT set in production — Railway injects $PORT automatically.
# Uncomment only for local dev if you need a specific port:
# PORT=8080

# ── Mobile App (Expo) ─────────────────────────────────────────────────────────
# The public hostname (no https://) used by the Expo bundle to reach the API.
# Set to your Railway domain after first deploy.
# Example:  myapp.up.railway.app
EXPO_PUBLIC_DOMAIN=your-railway-domain.up.railway.app
